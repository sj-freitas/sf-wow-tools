generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Faction {
  ALLIANCE
  HORDE
}

enum Role {
  HEALER
  TANK
  MELEE_DPS
  RANGED_DPS
}

// Guild roles that can be mapped to a Discord role of the guild's main server, for roster
// setup. (The Officer role is separate: it grants permissions, see Guild.officerRoleId.)
enum GuildRole {
  RAIDER
  SOCIAL
}

enum TaskType {
  POST
}

enum ScheduleKind {
  ONCE
  DAILY
  WEEKLY
}

enum TaskRunStatus {
  SUCCESS
  FAILED
  // A recurring occurrence that was skipped because the task caught up with a later one.
  MISSED
}

enum OfficerMessageAuthor {
  USER
  OFFICER
}

enum HoneypotAction {
  // Test mode: what the bot would have done.
  WOULD_BAN
  BANNED
  FAILED
}

// A WoW guild. It can be managed from more than one Discord server.
model Guild {
  id                      String                @id @default(uuid()) @db.Uuid
  name                    String
  realm                   String
  faction                 Faction
  // One of GAME_VERSIONS (src/game/game-version.ts); a string so adding a
  // version doesn't need a migration.
  gameVersion             String                @map("game_version")
  // Officers hold this role in the guild's main server (see DiscordServer.isMain)
  // and can manage the guild like a Guild-Assistant. Null = no officer role set.
  officerRoleId           String?               @map("officer_role_id")
  officerRoleName         String?               @map("officer_role_name")
  // One of the keys of REGIONS (src/config/regions.ts); decides the timezone schedules run in.
  region                  String                @default("EU")
  // Optional welcome post (markdown) shown on the guild's home page; null = none written yet.
  homeMarkdown            String?               @map("home_markdown")
  homeUpdatedAt           DateTime?             @map("home_updated_at")
  homeUpdatedById         String?               @map("home_updated_by_id") @db.Uuid
  // Where members' messages to the officers are posted; null until set in the guild settings.
  officerRequestServerId  String?               @map("officer_request_server_id")
  officerRequestChannelId String?               @map("officer_request_channel_id")
  officerConversations    OfficerConversation[]
  scheduledTasks          ScheduledTask[]
  honeypots               Honeypot[]
  servers                 DiscordServer[]
  roleMappings            GuildRoleMapping[]
  players                 Player[]
  access                  GuildAccess[]
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  @@unique([name, realm, gameVersion, region])
  @@map("guilds")
}

model DiscordServer {
  id        String   @id @default(uuid()) @db.Uuid
  // Discord's server (a.k.a. guild) snowflake id.
  discordId String   @unique @map("discord_id")
  // Display name, refreshed whenever a member logs in; empty until then.
  name      String   @default("")
  // Exactly one server per guild is the main one; kept in sync by GuildsService.
  isMain    Boolean  @default(false) @map("is_main")
  guildId   String   @map("guild_id") @db.Uuid
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("discord_servers")
}

// Optional: which Discord role (in the guild's main server) stands for a guild role.
// Cleared when the main server changes, since roles belong to a server.
model GuildRoleMapping {
  id              String    @id @default(uuid()) @db.Uuid
  guildId         String    @map("guild_id") @db.Uuid
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildRole       GuildRole @map("guild_role")
  discordRoleId   String    @map("discord_role_id")
  discordRoleName String    @map("discord_role_name")

  @@unique([guildId, guildRole])
  @@map("guild_role_mappings")
}

// A Discord user's membership in one guild: one Player per (guild, Discord
// user), so a user in several guilds has several Players. Not linked to User,
// since players may never log in to the backoffice.
model Player {
  id                 String      @id @default(uuid()) @db.Uuid
  discordUserId      String      @map("discord_user_id")
  // Best-effort display info; null until the user is seen by the bot or looked up.
  discordUsername    String?     @map("discord_username")
  discordDisplayName String?     @map("discord_display_name")
  guildId            String      @map("guild_id") @db.Uuid
  guild              Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characters         Character[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@unique([guildId, discordUserId])
  @@map("players")
}

model Character {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @map("player_id") @db.Uuid
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // Faction and realm are the owning guild's (player.guild).
  // A WoW class name, locked to a known set in code like gameVersion.
  class     String
  roles     Role[]
  // Both parts have at least 2 characters (CHECK constraints in the migrations). The last
  // name is empty when there is none, and required for game versions that say so.
  firstName String   @map("first_name")
  lastName  String   @default("") @map("last_name")
  isMain    Boolean  @default(false) @map("is_main")
  level     Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([playerId, firstName, lastName])
  @@map("characters")
}

// A backoffice user, created on first Discord login.
model User {
  id           String            @id @default(uuid()) @db.Uuid
  discordId    String            @unique @map("discord_id")
  username     String
  avatar       String?
  guildAccess  GuildAccess[]
  adminServers UserAdminServer[]
  sessions     Session[]
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

// Which guilds a backoffice user can see (and whether they can manage them).
// Rebuilt from Discord on every login; only guilds that exist in `guilds` get a row.
model GuildAccess {
  userId    String  @map("user_id") @db.Uuid
  guildId   String  @map("guild_id") @db.Uuid
  // Holds the "Guild-Assistant" role in every one of the guild's Discord servers.
  isAdmin   Boolean @default(false) @map("is_admin")
  // Holds the guild's officer role in its main server.
  isOfficer Boolean @default(false) @map("is_officer")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild     Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([userId, guildId])
  @@map("guild_access")
}

// Discord servers where the user holds the admin role and the bot is present,
// rebuilt on every login. Source for "which servers can I attach to a new guild".
model UserAdminServer {
  userId    String @map("user_id") @db.Uuid
  discordId String @map("discord_id")
  name      String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, discordId])
  @@map("user_admin_servers")
}

// Server-side login session. The cookie holds a random token; only its
// SHA-256 hash is stored, so a database leak can't be replayed as cookies.
model Session {
  id                    String    @id @default(uuid()) @db.Uuid
  tokenHash             String    @unique @map("token_hash")
  // The user's Discord OAuth access token (AES-256-GCM encrypted, see
  // auth/token-crypto.ts), kept so we can re-read their servers and roles on
  // demand. Null for sessions created before this existed.
  discordAccessToken    String?   @map("discord_access_token")
  discordTokenExpiresAt DateTime? @map("discord_token_expires_at")
  // Last time servers/roles were synced from Discord for this session.
  discordSyncedAt       DateTime  @default(now()) @map("discord_synced_at")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt             DateTime  @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@map("sessions")
}

// Something the background worker does on a schedule, defined by Officers in the backoffice.
// The schedule is stored in a friendly form and interpreted in the guild's region timezone;
// `nextRunAt` (UTC) is what the worker queries. `config`/`state` are per-type JSON (validated
// in code): for POST, config = channel, content, seed reactions; state = the posted message.
model ScheduledTask {
  id           String         @id @default(uuid()) @db.Uuid
  guildId      String         @map("guild_id") @db.Uuid
  guild        Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type         TaskType
  name         String
  enabled      Boolean        @default(true)
  scheduleKind ScheduleKind   @map("schedule_kind")
  // ONCE: the instant to run. DAILY/WEEKLY: wall-clock "HH:mm" (and ISO weekday 1-7) in the guild's timezone.
  runAt        DateTime?      @map("run_at")
  timeOfDay    String?        @map("time_of_day")
  weekday      Int?
  nextRunAt    DateTime?      @map("next_run_at")
  // Set while a worker is executing the task, so no other worker picks it up.
  leaseUntil   DateTime?      @map("lease_until")
  lastRunAt    DateTime?      @map("last_run_at")
  lastStatus   TaskRunStatus? @map("last_status")
  lastError    String?        @map("last_error")
  config       Json
  state        Json           @default("{}")
  createdById  String?        @map("created_by_id") @db.Uuid
  runs         TaskRun[]
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([enabled, nextRunAt])
  @@map("scheduled_tasks")
}

model TaskRun {
  id           String        @id @default(uuid()) @db.Uuid
  taskId       String        @map("task_id") @db.Uuid
  task         ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // The occurrence this run is for; unique so an occurrence runs at most once.
  scheduledFor DateTime      @map("scheduled_for")
  startedAt    DateTime      @default(now()) @map("started_at")
  finishedAt   DateTime?     @map("finished_at")
  status       TaskRunStatus
  error        String?

  @@unique([taskId, scheduledFor])
  @@map("task_runs")
}

// A channel where anyone who posts is banned (unless exempt). Not scheduled: the worker's
// gateway listener enforces it. In test mode it only logs what it would do.
model Honeypot {
  id              String          @id @default(uuid()) @db.Uuid
  guildId         String          @map("guild_id") @db.Uuid
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean         @default(true)
  testMode        Boolean         @default(true) @map("test_mode")
  discordServerId String          @map("discord_server_id")
  channelId       String          @unique @map("channel_id")
  logChannelId    String          @map("log_channel_id")
  createdChannel  Boolean         @default(false) @map("created_channel")
  events          HoneypotEvent[]
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("honeypots")
}

model HoneypotEvent {
  id            String         @id @default(uuid()) @db.Uuid
  honeypotId    String         @map("honeypot_id") @db.Uuid
  honeypot      Honeypot       @relation(fields: [honeypotId], references: [id], onDelete: Cascade)
  discordUserId String         @map("discord_user_id")
  username      String?
  messageId     String?        @map("message_id")
  action        HoneypotAction
  error         String?
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([honeypotId, createdAt])
  @@map("honeypot_events")
}

// A member's conversation with the officers (/contact-officer). The first message decides whether
// the member stays anonymous. `userDiscordId` is only for the bot (to DM replies and to check that
// whoever continues a conversation started it); it is never returned for an anonymous conversation.
model OfficerConversation {
  id            String           @id @default(uuid()) @db.Uuid
  guildId       String           @map("guild_id") @db.Uuid
  guild         Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // The 8-digit id members and officers use, unique within the guild.
  publicId      Int              @map("public_id")
  isAnonymous   Boolean          @map("is_anonymous")
  userDiscordId String           @map("user_discord_id")
  // The member's name at the time; only kept when the conversation is not anonymous.
  userName      String?          @map("user_name")
  messages      OfficerMessage[]
  createdAt     DateTime         @default(now()) @map("created_at")
  // Bumped by every message, so it is the "last activity".
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@unique([guildId, publicId])
  @@index([guildId, updatedAt])
  @@map("officer_conversations")
}

model OfficerMessage {
  id               String               @id @default(uuid()) @db.Uuid
  conversationId   String               @map("conversation_id") @db.Uuid
  conversation     OfficerConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author           OfficerMessageAuthor
  // Officer replies only: officers are never anonymous.
  officerDiscordId String?              @map("officer_discord_id")
  officerName      String?              @map("officer_name")
  content          String
  // The post in the officer channel, so follow-ups can reply to it.
  discordMessageId String?              @map("discord_message_id")
  // Officer replies only: whether the DM reached the member.
  dmDelivered      Boolean?             @map("dm_delivered")
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("officer_messages")
}
