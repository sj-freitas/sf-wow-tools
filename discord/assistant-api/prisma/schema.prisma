generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Faction {
  ALLIANCE
  HORDE
}

enum Role {
  HEALER
  TANK
  MELEE_DPS
  RANGED_DPS
}

// Guild roles that can be mapped to a Discord role of the guild's main server, for roster
// setup. (The Officer role is separate: it grants permissions, see Guild.officerRoleId.)
enum GuildRole {
  RAIDER
  SOCIAL
}

enum TaskType {
  POST
}

enum ScheduleKind {
  ONCE
  DAILY
  WEEKLY
  // Plugins only (posts are ONCE).
  MONTHLY
  // Plugins only: on the hour, and every five minutes (Professions List: cheap checks for changes).
  HOURLY
  EVERY_5_MINUTES
}

enum TaskRunStatus {
  SUCCESS
  FAILED
  // A recurring occurrence that was skipped because the task caught up with a later one.
  MISSED
}

enum OfficerMessageAuthor {
  USER
  OFFICER
}

enum HoneypotAction {
  // Test mode: what the bot would have done.
  WOULD_BAN
  BANNED
  FAILED
}

// A WoW guild. It can be managed from more than one Discord server.
model Guild {
  id                      String                     @id @default(uuid()) @db.Uuid
  name                    String
  realm                   String
  faction                 Faction
  // One of GAME_VERSIONS (src/game/game-version.ts); a string so adding a
  // version doesn't need a migration.
  gameVersion             String                     @map("game_version")
  // Officers hold this role in the guild's main server (see DiscordServer.isMain)
  // and can manage the guild like a Guild-Assistant. Null = no officer role set.
  officerRoleId           String?                    @map("officer_role_id")
  officerRoleName         String?                    @map("officer_role_name")
  // One of the keys of REGIONS (src/config/regions.ts); decides the timezone schedules run in.
  region                  String                     @default("EU")
  // Optional welcome post (markdown) shown on the guild's home page; null = none written yet.
  homeMarkdown            String?                    @map("home_markdown")
  homeUpdatedAt           DateTime?                  @map("home_updated_at")
  homeUpdatedById         String?                    @map("home_updated_by_id") @db.Uuid
  // Where members' messages to the officers are posted; null until set in the guild settings.
  officerRequestServerId  String?                    @map("officer_request_server_id")
  officerRequestChannelId String?                    @map("officer_request_channel_id")
  banner                  GuildBanner?
  officerConversations    OfficerConversation[]
  scheduledTasks          ScheduledTask[]
  honeypots               Honeypot[]
  // Plugins (prisma/plugins.prisma).
  plugins                 GuildPlugin[]
  pathAliases             GuildPathAlias[]
  servers                 DiscordServer[]
  roleMappings            GuildRoleMapping[]
  characterMemberships    CharacterGuildMembership[]
  access                  GuildAccess[]
  officerNotes            CharacterOfficerNote[]
  attributes              GuildAttribute[]
  // Event sign-ups (prisma/signup.prisma).
  signupSettings          SignupSettings?
  signupEvents            SignupEvent[]
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")

  @@unique([name, realm, gameVersion, region])
  @@map("guilds")
}

// The optional banner image of a guild, kept apart from the guild row so listing guilds never
// loads the image bytes.
// An address a guild had before it was renamed (or its realm, region or game version changed), so
// old links still work: the server redirects them to the guild's address now. A guild that takes
// an address over removes its alias.
model GuildPathAlias {
  // `<version>/<region>/<realm>/guilds/<name>`, as `guildPath` writes it.
  path      String   @id
  guildId   String   @map("guild_id") @db.Uuid
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([guildId])
  @@map("guild_path_aliases")
}

model GuildBanner {
  guildId     String   @id @map("guild_id") @db.Uuid
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  contentType String   @map("content_type")
  data        Bytes
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("guild_banners")
}

model DiscordServer {
  id        String   @id @default(uuid()) @db.Uuid
  // Discord's server (a.k.a. guild) snowflake id.
  discordId String   @unique @map("discord_id")
  // Display name, refreshed whenever a member logs in; empty until then.
  name      String   @default("")
  // Discord's icon hash (the picture shown next to the guild name); null when the server has none.
  icon      String?
  // Exactly one server per guild is the main one; kept in sync by GuildsService.
  isMain    Boolean  @default(false) @map("is_main")
  guildId   String   @map("guild_id") @db.Uuid
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("discord_servers")
}

// Optional: which Discord role (in the guild's main server) stands for a guild role.
// Cleared when the main server changes, since roles belong to a server.
model GuildRoleMapping {
  id              String    @id @default(uuid()) @db.Uuid
  guildId         String    @map("guild_id") @db.Uuid
  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  guildRole       GuildRole @map("guild_role")
  discordRoleId   String    @map("discord_role_id")
  discordRoleName String    @map("discord_role_name")

  @@unique([guildId, guildRole])
  @@map("guild_role_mappings")
}

// A Discord user, globally: one Player per Discord account, however many guilds they are in.
// Not linked to User, since players may never log in to the backoffice. Holds every character
// that account has registered, on any server; which guilds a character appears in is
// `CharacterGuildMembership`, not this.
model Player {
  id                 String      @id @default(uuid()) @db.Uuid
  discordUserId      String      @unique @map("discord_user_id")
  // Best-effort display info; null until the user is seen by the bot or looked up. Global too
  // (their Discord username), even though a per-server nickname could in principle differ.
  discordUsername    String?     @map("discord_username")
  discordDisplayName String?     @map("discord_display_name")
  characters         Character[]
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  @@map("players")
}

// A character belongs to a player, not a guild: its identity (this row) survives being renamed,
// changing race, class or faction, and being in several guilds' rosters at once (or none). What
// guilds it is in is `CharacterGuildMembership`. Its server (gameVersion/region/realm) is fixed at
// creation — moving a character to another realm is not supported.
model Character {
  id                 String                     @id @default(uuid()) @db.Uuid
  playerId           String                     @map("player_id") @db.Uuid
  player             Player                     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  // One of the game versions/regions/servers in src/game/<version>/config.ts; which guilds can
  // list this character (`addToGuild`) and faction compatibility (for migrating) key off these.
  gameVersion        String                     @map("game_version")
  region             String
  realm              String
  // Stored, not derived from race: some races (e.g. Forever's Skyborne, like Pandaren) exist in
  // both factions, so race alone can't say which one a given character committed to. Set from the
  // guild's faction when the character is created; changing it (a "faction change") is a deliberate
  // edit, checked the same way creation is (the new race, if any, must fit the new faction).
  faction            Faction
  // A WoW class name, locked to a known set in code like gameVersion. Race is too (checked
  // against `faction` and the class), always set (never empty; a CHECK enforces it).
  class              String
  race               String
  roles              Role[]
  // Both parts have at least 2 characters (CHECK constraints in the migrations). The last
  // name is empty when there is none, and required for game versions that say so.
  firstName          String                     @map("first_name")
  lastName           String                     @default("") @map("last_name")
  level              Int                        @default(1)
  // Free text written by the character's own player (never an Officer), on guilds whose server's
  // rule set is 'RP'. Shown to others only when bioVisible is set; always visible to its owner.
  // Guild-agnostic like the character itself: the same bio shows in every guild it is in.
  bio                String                     @default("")
  bioVisible         Boolean                    @default(false) @map("bio_visible")
  // Ownership: every character is claimed by its player (who added it, or for whom an Officer
  // did). Set when the player proved on Battle.net that it is theirs: from then on only they edit
  // or move it, not Officers (who can still add it to their guild or take it off). Set by hand
  // for now: the Battle.net check is a preview (src/battlenet).
  verifiedAt         DateTime?                  @map("verified_at")
  images             CharacterImage[]
  guilds             CharacterGuildMembership[]
  officerNotes       CharacterOfficerNote[]
  attributes         CharacterAttribute[]
  // Event sign-ups (prisma/signup.prisma).
  signupEntries      SignupEntry[]
  // Professions (prisma/professions.prisma).
  professions        CharacterProfession[]
  droppedProfessions ProfessionDrop[]
  professionSnapshot ProfessionSnapshot?
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")

  @@unique([playerId, gameVersion, region, realm, firstName, lastName], map: "characters_unique_per_server")
  @@map("characters")
}

// A character's presence in one guild's roster. Adding an existing character to another guild
// (whose server and faction it fits) just creates one of these — "migrating" a character does not
// copy it, it points the new guild at the same row. Removing a character from a guild's roster
// deletes this, not the character (which may still be in other guilds, or none).
model CharacterGuildMembership {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  guildId     String    @map("guild_id") @db.Uuid
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([characterId, guildId])
  @@index([guildId])
  @@map("character_guild_memberships")
}

// An image in a character's bio (see Character.bio), up to CharacterBioService.MAX_BIO_IMAGES.
model CharacterImage {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  contentType String    @map("content_type")
  size        Int
  data        Bytes
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId, createdAt])
  @@map("character_images")
}

// A guild's Officers' private note about one character (markdown, with images). Only Officers of
// that guild read or write it; its player never sees it. Keyed by guild and character rather than
// by the roster membership, so it survives the character leaving the roster and coming back.
model CharacterOfficerNote {
  id            String                      @id @default(uuid()) @db.Uuid
  guildId       String                      @map("guild_id") @db.Uuid
  guild         Guild                       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  characterId   String                      @map("character_id") @db.Uuid
  character     Character                   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  markdown      String                      @default("")
  // Who saved it last (the Officer's display name), for the note's page.
  updatedByName String?                     @map("updated_by_name")
  images        CharacterOfficerNoteImage[]
  createdAt     DateTime                    @default(now()) @map("created_at")
  updatedAt     DateTime                    @updatedAt @map("updated_at")

  @@unique([guildId, characterId])
  @@map("character_officer_notes")
}

// An image of an Officer note (see CharacterOfficerNote), up to CharacterNotesService.MAX_NOTE_IMAGES.
model CharacterOfficerNoteImage {
  id          String               @id @default(uuid()) @db.Uuid
  noteId      String               @map("note_id") @db.Uuid
  note        CharacterOfficerNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  contentType String               @map("content_type")
  size        Int
  data        Bytes
  createdAt   DateTime             @default(now()) @map("created_at")

  @@index([noteId, createdAt])
  @@map("character_officer_note_images")
}

// A label a guild gives some of its characters ("Switcher", "Recruit", "Bank alt"…), with a colour
// it is shown in. As many as the guild wants; Officers manage them on the roster, everyone in the
// guild sees them, and roster post tags read them (`roster[i].attributes`). The name is unique
// within the guild; colours can repeat. `color` is one of ATTRIBUTE_COLORS (guild-attributes.ts).
model GuildAttribute {
  id         String               @id @default(uuid()) @db.Uuid
  guildId    String               @map("guild_id") @db.Uuid
  guild      Guild                @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name       String
  color      String
  characters CharacterAttribute[]
  createdAt  DateTime             @default(now()) @map("created_at")

  @@unique([guildId, name])
  @@map("guild_attributes")
}

// A character having one of its guild's attributes. Kept if the character leaves the roster and
// comes back, like officer notes; it goes when the attribute or the character is deleted.
model CharacterAttribute {
  attributeId String         @map("attribute_id") @db.Uuid
  attribute   GuildAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  characterId String         @map("character_id") @db.Uuid
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now()) @map("created_at")

  @@id([attributeId, characterId])
  @@index([characterId])
  @@map("character_attributes")
}

// A backoffice user, created on first Discord login.
model User {
  id           String            @id @default(uuid()) @db.Uuid
  discordId    String            @unique @map("discord_id")
  username     String
  // Discord's display name (global name); null until the next login, and for accounts without one.
  displayName  String?           @map("display_name")
  avatar       String?
  guildAccess  GuildAccess[]
  adminServers UserAdminServer[]
  sessions     Session[]
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

// Which guilds a backoffice user can see (and whether they can manage them).
// Rebuilt from Discord on every login; only guilds that exist in `guilds` get a row.
model GuildAccess {
  userId    String  @map("user_id") @db.Uuid
  guildId   String  @map("guild_id") @db.Uuid
  // Holds the "Guild-Assistant" role in every one of the guild's Discord servers.
  isAdmin   Boolean @default(false) @map("is_admin")
  // Holds the guild's officer role in its main server.
  isOfficer Boolean @default(false) @map("is_officer")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild     Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([userId, guildId])
  @@map("guild_access")
}

// Discord servers where the user holds the admin role and the bot is present,
// rebuilt on every login. Source for "which servers can I attach to a new guild".
model UserAdminServer {
  userId    String  @map("user_id") @db.Uuid
  discordId String  @map("discord_id")
  name      String
  // Discord's icon hash, as on DiscordServer; null when the server has none.
  icon      String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, discordId])
  @@map("user_admin_servers")
}

// Server-side login session. The cookie holds a random token; only its
// SHA-256 hash is stored, so a database leak can't be replayed as cookies.
model Session {
  id                    String    @id @default(uuid()) @db.Uuid
  tokenHash             String    @unique @map("token_hash")
  // The user's Discord OAuth access token (AES-256-GCM encrypted, see
  // auth/token-crypto.ts), kept so we can re-read their servers and roles on
  // demand. Null for sessions created before this existed.
  discordAccessToken    String?   @map("discord_access_token")
  discordTokenExpiresAt DateTime? @map("discord_token_expires_at")
  // Last time servers/roles were synced from Discord for this session.
  discordSyncedAt       DateTime  @default(now()) @map("discord_synced_at")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt             DateTime  @map("expires_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@map("sessions")
}

// Something the background worker does on a schedule, defined by Officers in the backoffice.
// The schedule is stored in a friendly form and interpreted in the guild's region timezone;
// `nextRunAt` (UTC) is what the worker queries. `config`/`state` are per-type JSON (validated
// in code): for POST, config = channel, content, seed reactions; state = the posted message.
model ScheduledTask {
  id             String         @id @default(uuid()) @db.Uuid
  guildId        String         @map("guild_id") @db.Uuid
  guild          Guild          @relation(fields: [guildId], references: [id], onDelete: Cascade)
  type           TaskType
  name           String
  enabled        Boolean        @default(true)
  scheduleKind   ScheduleKind   @map("schedule_kind")
  // ONCE: the instant to run. DAILY/WEEKLY: wall-clock "HH:mm" (and ISO weekday 1-7) in the guild's timezone.
  runAt          DateTime?      @map("run_at")
  timeOfDay      String?        @map("time_of_day")
  weekday        Int?
  nextRunAt      DateTime?      @map("next_run_at")
  // Set while a worker is executing the task, so no other worker picks it up.
  leaseUntil     DateTime?      @map("lease_until")
  lastRunAt      DateTime?      @map("last_run_at")
  lastStatus     TaskRunStatus? @map("last_status")
  lastError      String?        @map("last_error")
  config         Json
  state          Json           @default("{}")
  // Live updates (POST): while true, the worker keeps the post's live tags up to date and the
  // backoffice re-reads its reaction counts; false freezes both as they last were.
  tracked        Boolean        @default(true)
  // The reaction counts of each message as last read from Discord, shown in the backoffice:
  // { [part id]: { at: ISO time, reactions: [{ emoji, emojiId, count }] } }.
  reactionCounts Json           @default("{}") @map("reaction_counts")
  createdById    String?        @map("created_by_id") @db.Uuid
  runs           TaskRun[]
  // The dynamic features (e.g. [reactions:...]) this post's text uses, and the posts whose
  // reactions other posts read.
  images         PostImage[]
  tracking       PostTracking[] @relation("TrackedPost")
  trackedBy      PostTracking[] @relation("TrackingSource")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  @@index([enabled, nextRunAt])
  @@map("scheduled_tasks")
}

// One dynamic feature in a post's text, like [reactions:<post id>,<emoji>,<type>]. The worker
// re-reads the source post's reactions every minute and edits the post when they changed. Rows
// are created, kept and removed by saving the post, so they always match its text.
model PostTracking {
  id              String         @id @default(uuid()) @db.Uuid
  // The post whose text contains the feature (the message that gets edited).
  taskId          String         @map("task_id") @db.Uuid
  task            ScheduledTask  @relation("TrackedPost", fields: [taskId], references: [id], onDelete: Cascade)
  // Where the reactions are read: a scheduled post of the bot (found by name or message id, may be
  // the same post; its message is looked up each time), or, for any other message in one of the
  // guild's servers, its channel and message ids.
  sourceTaskId    String?        @map("source_task_id") @db.Uuid
  sourceTask      ScheduledTask? @relation("TrackingSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  sourceChannelId String?        @map("source_channel_id")
  sourceMessageId String?        @map("source_message_id")
  // How the text points at that post, as written (`id:<uuid>`, `name:<lower-cased name>` or
  // `self`), so a post renamed later keeps working until its text is saved again.
  postRef         String         @default("") @map("post_ref")
  // The emoji: unicode, or `name:id` for a custom one.
  emoji           String
  // Always "custom" now (every tag is a JavaScript expression); kept from when tags had presets.
  type            String
  // Hash of who had reacted at the last check: equal means nothing changed, nothing more to fetch.
  lastHash        String?        @map("last_hash")
  // Who had reacted at the last check: [{ id, name }].
  lastUsers       Json           @default("[]") @map("last_users")
  checkedAt       DateTime?      @map("checked_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  @@unique([taskId, postRef, emoji, type])
  @@index([sourceTaskId])
  @@map("post_tracking")
}

// An image attached to one message (part) of a post. Uploaded before the post is saved, so it may
// belong to no post yet (`taskId` null) until the post that uses it is saved; unused uploads are
// removed by the worker after a day. The bytes are kept because the post goes out later.
model PostImage {
  id          String         @id @default(uuid()) @db.Uuid
  guildId     String         @map("guild_id") @db.Uuid
  taskId      String?        @map("task_id") @db.Uuid
  task        ScheduledTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contentType String         @map("content_type")
  size        Int
  data        Bytes
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([taskId])
  @@index([guildId, taskId, createdAt])
  @@map("post_images")
}

model TaskRun {
  id           String        @id @default(uuid()) @db.Uuid
  taskId       String        @map("task_id") @db.Uuid
  task         ScheduledTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  // The occurrence this run is for; unique so an occurrence runs at most once.
  scheduledFor DateTime      @map("scheduled_for")
  startedAt    DateTime      @default(now()) @map("started_at")
  finishedAt   DateTime?     @map("finished_at")
  status       TaskRunStatus
  error        String?

  @@unique([taskId, scheduledFor])
  @@map("task_runs")
}

// A channel where anyone who posts is banned (unless exempt). Not scheduled: the worker's
// gateway listener enforces it. In test mode it only logs what it would do.
model Honeypot {
  id              String          @id @default(uuid()) @db.Uuid
  guildId         String          @map("guild_id") @db.Uuid
  guild           Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name            String
  enabled         Boolean         @default(true)
  testMode        Boolean         @default(true) @map("test_mode")
  discordServerId String          @map("discord_server_id")
  channelId       String          @unique @map("channel_id")
  logChannelId    String          @map("log_channel_id")
  createdChannel  Boolean         @default(false) @map("created_channel")
  events          HoneypotEvent[]
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@map("honeypots")
}

model HoneypotEvent {
  id            String         @id @default(uuid()) @db.Uuid
  honeypotId    String         @map("honeypot_id") @db.Uuid
  honeypot      Honeypot       @relation(fields: [honeypotId], references: [id], onDelete: Cascade)
  discordUserId String         @map("discord_user_id")
  username      String?
  messageId     String?        @map("message_id")
  action        HoneypotAction
  error         String?
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([honeypotId, createdAt])
  @@map("honeypot_events")
}

// A member's conversation with the officers (/contact-officer). The first message decides whether
// the member stays anonymous. `userDiscordId` is only for the bot (to DM replies and to check that
// whoever continues a conversation started it); it is never returned for an anonymous conversation.
model OfficerConversation {
  id            String           @id @default(uuid()) @db.Uuid
  guildId       String           @map("guild_id") @db.Uuid
  guild         Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // The 8-digit id members and officers use, unique within the guild.
  publicId      Int              @map("public_id")
  isAnonymous   Boolean          @map("is_anonymous")
  userDiscordId String           @map("user_discord_id")
  // The member's name at the time; only kept when the conversation is not anonymous.
  userName      String?          @map("user_name")
  messages      OfficerMessage[]
  // Set when an officer locks the conversation: nobody can write to it any more.
  lockedAt      DateTime?        @map("locked_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  // Bumped by every message, so it is the "last activity".
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@unique([guildId, publicId])
  @@index([guildId, updatedAt])
  @@map("officer_conversations")
}

// The one optional image of a message, kept here (not only in the Discord channel) because
// Discord's file links expire and officers may clear or move the request channel.
model OfficerAttachment {
  id          String         @id @default(uuid()) @db.Uuid
  messageId   String         @unique @map("message_id") @db.Uuid
  message     OfficerMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  contentType String         @map("content_type")
  size        Int
  data        Bytes
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("officer_attachments")
}

model OfficerMessage {
  id               String               @id @default(uuid()) @db.Uuid
  conversationId   String               @map("conversation_id") @db.Uuid
  conversation     OfficerConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author           OfficerMessageAuthor
  // Officer replies only: officers are never anonymous.
  officerDiscordId String?              @map("officer_discord_id")
  officerName      String?              @map("officer_name")
  content          String
  // The post in the officer channel, so follow-ups can reply to it.
  discordMessageId String?              @map("discord_message_id")
  // Officer replies only: whether the DM reached the member.
  dmDelivered      Boolean?             @map("dm_delivered")
  attachment       OfficerAttachment?
  createdAt        DateTime             @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("officer_messages")
}
