// Professions (src/professions): what each character can craft, imported from the Guild Assistant
// Professions addon's export (addons/GuildAssistantProfessions), and a cache of the Wowhead names
// of the recipes. Kept in its own file and tables; the only reference from schema.prisma is the
// back-relation Prisma requires on Character.

model CharacterProfession {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  // As the game names it ("Tailoring"); the export's language.
  name        String
  skill       Int?
  maxSkill    Int?      @map("max_skill")
  // The recipes, as WoW spell ids; `itemIds` when the game only gave the crafted item.
  spellIds    Int[]     @map("spell_ids")
  itemIds     Int[]     @map("item_ids")
  importedAt  DateTime  @default(now()) @map("imported_at")
  // The addon's history of it (GuildAssistantProfessions 1.0+): when the character learned it (the
  // first time the addon saw it, again after unlearning it) and last changed it, by the game
  // server's clock. Null for older exports. `learnedAt` tells a profession learned again after
  // being dropped here from an old copy of the dropped one (see ProfessionDrop).
  learnedAt   DateTime? @map("learned_at")
  recordedAt  DateTime? @map("recorded_at")

  @@unique([characterId, name])
  @@map("character_professions")
}

// A main profession dropped from a character: by "Drop this profession", or because a newer export
// of the character no longer has it (unlearned and replaced, e.g. Blacksmithing for Engineering).
// An import doesn't bring it back unless the export says it was learned again after `droppedAt`.
// A character keeps its last two (it has two main professions).
model ProfessionDrop {
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  name        String
  droppedAt   DateTime  @default(now()) @map("dropped_at")

  @@id([characterId, name])
  @@map("profession_drops")
}

// The date of the newest export of a character applied (the addon's `updated` for it: its last
// change in game): an export newer than this decides which main professions it has.
model ProfessionSnapshot {
  characterId String    @id @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  takenAt     DateTime  @map("taken_at")

  @@map("profession_snapshots")
}

enum WowheadKind {
  SPELL
  ITEM

  @@map("wowhead_kind")
}

// What Wowhead says about a spell or item, looked up once and kept (names don't change). The link
// is built from the guild's game version (`wowheadPath` in its game config), so one row serves all.
model WowheadEntry {
  kind        WowheadKind
  id          Int
  // English name, for search and display; null until looked up.
  englishName String?     @map("english_name")
  icon        String?
  // Wowhead has no such id: not asked again.
  missing     Boolean     @default(false)
  fetchedAt   DateTime?   @map("fetched_at")

  @@id([kind, id])
  @@map("wowhead_entries")
}

enum RecipeSourceKind {
  ITEM
  TRAINER

  @@map("recipe_source_kind")
}

// How recipes are obtained, as players' GuildAssistant Professions addons saw it in game (1.3.0 and
// later): where a recipe item is sold, dropped, fished or given by a quest (ITEM, `key` its item
// id), and which trainer teaches a recipe for how much (TRAINER, `key` "item:<item made>" or
// "name:<recipe name>"). Gathered from every import (RecipeSourcesService) and published (GET
// /api/recipe-sources) for GuildAssistant Database's data build. No player or guild in it, only
// how many users reported each.
model RecipeSource {
  kind        RecipeSourceKind
  key         String
  // As the addon writes it: "V:Tanaris=Krinkle Goodsteel" (ITEM), "Stormwind City=Grimand Elmore"
  // (TRAINER).
  entry       String
  // A trainer's cost, in copper.
  cost        Int?
  // The users whose imports reported it (at most 20), to count them.
  reporters   String[]
  firstSeenAt DateTime         @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime         @default(now()) @map("last_seen_at")

  @@id([kind, key, entry])
  @@map("recipe_sources")
}
