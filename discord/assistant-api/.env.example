# HTTP port the API listens on
PORT=3000

# Origin(s) allowed to call this API via CORS (comma-separated).
# The Vite dev server for assistant-backoffice defaults to this.
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres connection string. Use the "Direct connection" string
# (port 5432), not the pooled/Transaction one (port 6543) — Prisma Migrate
# needs a direct connection to run migrations.
# (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Discord application credentials (https://discord.com/developers/applications)
# DISCORD_TOKEN and DISCORD_APPLICATION_ID are only used by
# `npm run commands:register` (never read by the running server).
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: set during development to register commands to a single guild
# instead of globally, so changes propagate instantly.
DISCORD_GUILD_ID=
# Used at runtime by DiscordInteractionsController to verify Discord's
# Ed25519 request signature on every interaction.
DISCORD_PUBLIC_KEY=
