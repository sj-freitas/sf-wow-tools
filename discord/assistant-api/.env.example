# HTTP port the API listens on
PORT=3000

# Origin(s) allowed to call this API via CORS (comma-separated).
# The Vite dev server for assistant-backoffice defaults to this.
CORS_ORIGIN=http://localhost:5173

# Supabase Postgres connection string. Use the "Direct connection" string
# (port 5432), not the pooled/Transaction one (port 6543) — Prisma Migrate
# needs a direct connection to run migrations.
# (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# Optional: Redis for the server-side cache, shared by the API and the worker. On Render, use the
# Key Value instance's internal URL (redis://red-...:6379). Leave it empty locally (Render's Key Value
# doesn't accept outside connections): the cache is then kept in memory.
REDIS_URL=

# Discord application credentials (https://discord.com/developers/applications)
# DISCORD_TOKEN and DISCORD_APPLICATION_ID are used by
# `npm run commands:register`, and at runtime for backoffice login
# (DISCORD_TOKEN reads each server's roles to find the Guild-Assistant role).
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Optional: set during development to register commands to a single guild
# instead of globally, so changes propagate instantly.
DISCORD_GUILD_ID=
# Used at runtime by DiscordInteractionsController to verify Discord's
# Ed25519 request signature on every interaction.
DISCORD_PUBLIC_KEY=

# Optional: the "Add the bot to your server" link shown on the public landing page and in the
# guild setup instructions. Left empty, it is built from DISCORD_APPLICATION_ID with the
# permissions the bot needs.
BOT_INVITE_URL=
# Optional: contact address shown on the public privacy policy page.
CONTACT_EMAIL=
# Optional: the website's address, for links the bot posts in Discord (event sign-ups). Left
# empty, it is the origin of DISCORD_OAUTH_REDIRECT_URI, else https://guildassistant.app.
SITE_URL=

# Backoffice "Login with Discord" (OAuth2). Same Discord application as the bot:
# Developer Portal -> OAuth2 -> copy Client Secret, and add the redirect URI below
# under OAuth2 -> Redirects (must match exactly). Runtime, read by AuthModule.
# In dev the backoffice runs on :5173 and proxies /api, so use that origin.
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Battle.net developer client (https://develop.battle.net/access/clients), for the TEST
# "Load from armory" button in the character form. Optional: without both values the button is
# hidden. The server logs in with these (client credentials); no player login is involved.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Secret used to encrypt users' Discord access tokens stored with their session
# (AES-256-GCM). Any long random string: `openssl rand -base64 32`. Changing it
# invalidates stored tokens (users must log in again).
SESSION_ENCRYPTION_KEY=
