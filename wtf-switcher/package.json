{
  "name": "wtf-switcher",
  "productName": "WTF Switcher",
  "version": "1.0.1",
  "description": "Keeps a World of Warcraft UI (its WTF folder) for each screen setup, and switches to the right one when the screens change.",
  "author": "Sérgio Freitas",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "test": "node --require ts-node/register --test \"src/**/*.spec.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write src scripts",
    "format:check": "prettier --check src scripts",
    "icons": "node scripts/make-icons.mjs",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.sjfreitas.wtfswitcher",
    "productName": "WTF Switcher",
    "artifactName": "WTF-Switcher-${version}-${os}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "assets/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": "-",
      "hardenedRuntime": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
